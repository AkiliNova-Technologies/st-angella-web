generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRoleCode {
  SUPER_ADMIN
  EDITOR
  REVIEWER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum ContentEntityType {
  PAGE
  NEWS_ARTICLE
  SCHOOL_EVENT
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

enum MediaKind {
  IMAGE
  DOCUMENT
  BRAND_ASSET
}

enum ConsentStatus {
  NOT_REQUIRED
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  DELETED
}

model StaffProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId  String   @unique @map("auth_user_id") @db.Uuid
  displayName String   @map("display_name") @db.VarChar(120)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships StaffMembership[]
  pagesCreated PageContent[] @relation("PageCreator")
  articlesCreated NewsArticle[] @relation("ArticleCreator")
  eventsCreated SchoolEvent[] @relation("EventCreator")
  revisions ContentRevision[] @relation("RevisionAuthor")
  reviews ContentReview[] @relation("Reviewer")
  mediaUploaded MediaAsset[] @relation("MediaUploader")
  consentRecorded MediaConsentRecord[] @relation("ConsentRecorder")
  auditEntries AuditLog[] @relation("AuditActor")
  @@map("staff_profiles")
}

model StaffRole {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        StaffRoleCode @unique
  description String @db.VarChar(240)
  memberships StaffMembership[]
  @@map("staff_roles")
}

model StaffMembership {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  roleId    String @map("role_id") @db.Uuid
  grantedBy String? @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  profile StaffProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role StaffRole @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@unique([profileId, roleId])
  @@index([roleId])
  @@index([grantedBy])
  @@map("staff_memberships")
}

model PageContent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique @db.VarChar(160)
  title String @db.VarChar(200)
  body Json
  status ContentStatus @default(DRAFT)
  createdById String @map("created_by_id") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy StaffProfile @relation("PageCreator", fields: [createdById], references: [id], onDelete: Restrict)
  @@index([status, publishedAt])
  @@index([createdById])
  @@map("page_contents")
}

model NewsArticle {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique @db.VarChar(160)
  title String @db.VarChar(200)
  summary String @db.VarChar(500)
  body Json
  status ContentStatus @default(DRAFT)
  featuredMediaId String? @map("featured_media_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy StaffProfile @relation("ArticleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  featuredMedia MediaAsset? @relation("ArticleFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  @@index([status, publishedAt])
  @@index([featuredMediaId])
  @@index([createdById])
  @@map("news_articles")
}

model SchoolEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique @db.VarChar(160)
  title String @db.VarChar(200)
  summary String @db.VarChar(500)
  body Json
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt DateTime? @map("ends_at") @db.Timestamptz(6)
  location String? @db.VarChar(240)
  status ContentStatus @default(DRAFT)
  featuredMediaId String? @map("featured_media_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy StaffProfile @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  featuredMedia MediaAsset? @relation("EventFeaturedMedia", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  @@index([status, startsAt])
  @@index([featuredMediaId])
  @@index([createdById])
  @@map("school_events")
}

model ContentRevision {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType ContentEntityType @map("entity_type")
  entityId String @map("entity_id") @db.Uuid
  revisionNumber Int @map("revision_number")
  snapshot Json
  authorId String @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  author StaffProfile @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviews ContentReview[]
  @@unique([entityType, entityId, revisionNumber])
  @@index([entityType, entityId, createdAt])
  @@index([authorId])
  @@map("content_revisions")
}

model ContentReview {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  reviewerId String @map("reviewer_id") @db.Uuid
  decision ReviewDecision
  notes String? @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  revision ContentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  reviewer StaffProfile @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  @@unique([revisionId, reviewerId])
  @@index([reviewerId, createdAt])
  @@map("content_reviews")
}

model MediaCategory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique @db.VarChar(80)
  slug String @unique @db.VarChar(80)
  assets MediaAsset[]
  @@map("media_categories")
}

model MediaAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucket String @db.VarChar(80)
  objectPath String @unique @map("object_path") @db.VarChar(500)
  kind MediaKind
  mimeType String @map("mime_type") @db.VarChar(120)
  byteSize Int @map("byte_size")
  altText String? @map("alt_text") @db.VarChar(500)
  categoryId String? @map("category_id") @db.Uuid
  uploadedById String @map("uploaded_by_id") @db.Uuid
  isApproved Boolean @default(false) @map("is_approved")
  isPublic Boolean @default(false) @map("is_public")
  containsPupils Boolean @default(false) @map("contains_pupils")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  category MediaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uploadedBy StaffProfile @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  consentRecords MediaConsentRecord[]
  featuredArticles NewsArticle[] @relation("ArticleFeaturedMedia")
  featuredEvents SchoolEvent[] @relation("EventFeaturedMedia")
  @@index([categoryId])
  @@index([isApproved, isPublic])
  @@index([uploadedById])
  @@map("media_assets")
}

model MediaConsentRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  status ConsentStatus
  referenceCode String? @map("reference_code") @db.VarChar(120)
  validFrom DateTime? @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date
  notes String? @db.VarChar(1000)
  recordedById String @map("recorded_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  recordedBy StaffProfile @relation("ConsentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  @@index([mediaAssetId, status])
  @@index([recordedById])
  @@map("media_consent_records")
}

model AdmissionEnquiry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guardianName String @map("guardian_name") @db.VarChar(100)
  email String @db.VarChar(254)
  phone String @db.VarChar(30)
  intendedClass String @map("intended_class") @db.VarChar(20)
  message String @db.VarChar(1500)
  status EnquiryStatus @default(NEW)
  sourceFingerprint String? @map("source_fingerprint") @db.VarChar(128)
  retentionUntil DateTime @map("retention_until") @db.Date
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([status, createdAt])
  @@index([retentionUntil])
  @@map("admission_enquiries")
}

model ContactEnquiry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.VarChar(100)
  email String @db.VarChar(254)
  phone String @db.VarChar(30)
  message String @db.VarChar(1500)
  status EnquiryStatus @default(NEW)
  sourceFingerprint String? @map("source_fingerprint") @db.VarChar(128)
  retentionUntil DateTime @map("retention_until") @db.Date
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([status, createdAt])
  @@index([retentionUntil])
  @@map("contact_enquiries")
}

model SchoolSettings {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key String @unique @db.VarChar(120)
  value Json
  isPublic Boolean @default(false) @map("is_public")
  updatedBy String? @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([updatedBy])
  @@map("school_settings")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String @db.VarChar(100)
  entityType String @map("entity_type") @db.VarChar(100)
  entityId String? @map("entity_id") @db.Uuid
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor StaffProfile? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
